# Copy to .env for local dev. On Render, set these in the service's
# Environment tab instead - .env is gitignored and never deployed.

# Port the server listens on. Render sets this automatically in production;
# only needed locally.
PORT=4000

# Shared secret the frontend must send as the x-api-key header on every
# request. Generate something random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Exact origin of the deployed frontend (no trailing slash), e.g.
# https://your-app.vercel.app - restricts which sites' browsers are allowed
# to call this API. Leave unset locally to allow any origin.
ALLOWED_ORIGIN=

# flowdb-server's OWN Postgres database - stores Tablespace's application
# data (projects/diagrams/checkpoints), NOT the arbitrary databases users
# introspect via /api/introspect. This is the SAME Postgres instance the
# separate flowdb-migrations repo manages via Alembic (see that repo's own
# .env for the underlying host/user/password/dbname) - copy the equivalent
# value from there, assembled as a single connection string:
#   postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# 32-byte key (base64) used to encrypt Connected sources' own connection
# strings at rest (tablespace_sources.connection_string_encrypted -
# src/lib/crypto.js). Losing/rotating this makes every already-stored
# connection string undecryptable, so back it up like any other secret.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=

# --- Clerk (authentication) --------------------------------------------
# Clerk is the identity/auth source of truth; this server verifies the
# session token on every /api request (clerkMiddleware + getAuth) and
# mirrors users into its own tablespace_users table via the webhook below.
# Clerk application: app_3Ip2lM3BGydKM50x6xsiK6AD3Vf (dev instance keys are
# pk_test_/sk_test_; create a separate production instance for pk_live_).

# Both keys from the Clerk dashboard's API keys page. @clerk/express needs
# BOTH at runtime - a missing publishable key makes clerkMiddleware() throw
# on every request (500). The publishable key ("pk_test_"/"pk_live_") is
# the same value the frontend uses and is not secret; the secret key
# ("sk_...") is server-only and never ships to the browser.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Signing secret for the POST /webhooks/clerk endpoint, from the Clerk
# dashboard's Webhooks page (starts "whsec_"). Used to verify the Svix
# signature on user.created / user.updated / user.deleted events.
CLERK_WEBHOOK_SECRET=

# --- Email (optional) -------------------------------------------------
# Sends a welcome email on user.created (via the Clerk webhook above).
# Entirely optional: with RESEND_API_KEY unset, the send is a logged
# no-op and nothing else changes.
#   RESEND_API_KEY      - from https://resend.com/api-keys
#   WELCOME_EMAIL_FROM  - "Tablespace <welcome@yourdomain.com>"; needs a
#                         domain verified in Resend. Left unset, it uses
#                         Resend's shared test sender, which only delivers
#                         to the Resend account owner's own address.
#   APP_URL             - link target for the email's button; falls back
#                         to ALLOWED_ORIGIN, then http://localhost:5173
RESEND_API_KEY=
WELCOME_EMAIL_FROM=
APP_URL=
